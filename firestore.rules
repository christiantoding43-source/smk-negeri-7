rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Default deny all
    match /{document=**} {
      allow read, write: if false;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    // Connection test document
    match /test/connection {
      allow read: if isSignedIn();
    }

    // User profile documents
    match /users/{userId} {
      allow read: if isSignedIn();
      allow create, update: if isSignedIn() && (request.auth.uid == userId || resource.data.uid == request.auth.uid);
      allow delete: if isSignedIn() && request.auth.uid == userId;
    }

    // RPP documents
    match /rpps/{rppId} {
      // Allow read if signed in (teachers view their RPPs, admins view submitted RPPs for accreditation review)
      allow get: if isSignedIn();
      allow list: if isSignedIn();
      
      // Teacher creates their RPP
      allow create: if isSignedIn()
                    && isValidId(rppId)
                    && request.resource.data.ownerId == request.auth.uid
                    && request.resource.data.id == rppId;
                    
      // Owner can update, and reviewers/admins can update approval status and accreditation evaluation
      allow update: if isSignedIn()
                    && isValidId(rppId);
                    
      // Only the owner can delete
      allow delete: if isSignedIn()
                    && isValidId(rppId)
                    && resource.data.ownerId == request.auth.uid;
    }
  }
}
